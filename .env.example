# Copia para .env e ajusta conforme necessário.

# Pasta-raiz das consolas no NAS (modo nativo). Em Docker é mapeada para /games.
# Usada apenas quando GAME_SOURCES (abaixo) NÃO está definido.
GAMES_ROOT=/volume1/jogos

# Mapeamento explícito consola=caminho, para consolas em volumes diferentes.
# Se definido, tem prioridade sobre GAMES_ROOT. Um par por linha (ou separados por ';').
# GAME_SOURCES="Nintendo Switch=/volumeUSB6/usbshare/SWITCH GAMES;Xbox 360=/volumeUSB3/usbshare/XBOX 360 (GAMES)"

# Onde guardar a base de dados e as capas (modo nativo).
DATA_DIR=/volume1/jogos/.catalog

# Chave da API do SteamGridDB para descarregar capas automaticamente.
# Gratuita em: https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# Metadados (ano, género, descrição) via IGDB — autenticação pela Twitch.
# Cria uma app em https://dev.twitch.tv/console/apps e copia o Client ID/Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Porta do servidor web.
PORT=8088
